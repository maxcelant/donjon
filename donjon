#!/usr/bin/env python3
import argparse
import ast
import json
import os
import shutil
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path


class DonjonError(Exception):
    pass


CONFIG_FILE = Path(
    os.path.expandvars(
        os.path.expanduser(os.environ.get("DONJON_CONFIG") or "~/.donjon/config.yaml")
    )
)
CONFIG_LEAVES = {
    "pi.path",
    "pi.sessionDir",
    "claude.path",
    "claude.sessionDir",
    "tools.fzf.path",
}
CONFIG_BRANCHES = {"pi", "claude", "tools", "tools.fzf"}
CONFIG_TEMPLATE = """pi:
  path: ""
  sessionDir: ""

claude:
  path: ""
  sessionDir: ""

tools:
  fzf:
    path: ""
"""

STATE_FILE = Path.home() / ".donjon/state.json"
PI_SESSION_DIR = Path.home() / ".pi/agent/sessions"
CLAUDE_SESSION_DIR = Path.home() / ".claude/projects"
COMMAND_PATHS = {"pi": "pi", "claude": "claude", "fzf": "fzf"}


def init_config():
    try:
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        if not CONFIG_FILE.exists():
            CONFIG_FILE.write_text(CONFIG_TEMPLATE)
            CONFIG_FILE.chmod(0o600)
    except OSError as error:
        raise DonjonError(f"cannot initialize {CONFIG_FILE}: {error}") from error


def read_config():
    init_config()
    values = {}
    stack = []
    try:
        lines = CONFIG_FILE.read_text().splitlines()
    except OSError as error:
        raise DonjonError(f"cannot read {CONFIG_FILE}: {error}") from error
    for number, line in enumerate(lines, 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if "\t" in line:
            raise DonjonError(f"tabs are not allowed at {CONFIG_FILE}:{number}")
        indent = len(line) - len(line.lstrip(" "))
        if indent % 2:
            raise DonjonError(f"invalid indentation at {CONFIG_FILE}:{number}")
        while stack and indent <= stack[-1][0]:
            stack.pop()
        if (stack and indent != stack[-1][0] + 2) or (not stack and indent):
            raise DonjonError(f"invalid indentation at {CONFIG_FILE}:{number}")
        key, separator, value = stripped.partition(":")
        key = key.strip()
        value = value.strip()
        if not separator or not key:
            raise DonjonError(f"invalid config at {CONFIG_FILE}:{number}")
        full_key = ".".join([item[1] for item in stack] + [key])
        if not value:
            if full_key not in CONFIG_BRANCHES:
                raise DonjonError(f"unknown config section {full_key!r} at {CONFIG_FILE}:{number}")
            stack.append((indent, key))
            continue
        if full_key not in CONFIG_LEAVES:
            raise DonjonError(f"unknown config key {full_key!r} at {CONFIG_FILE}:{number}")
        if value[0] in "\"'":
            try:
                value = ast.literal_eval(value)
            except (SyntaxError, ValueError) as error:
                raise DonjonError(f"invalid value at {CONFIG_FILE}:{number}") from error
            if not isinstance(value, str):
                raise DonjonError(f"config value {full_key!r} must be a string")
        else:
            value = value.split(" #", 1)[0].rstrip()
        values[full_key] = value
    return values


def expand_path(value):
    return Path(os.path.expandvars(os.path.expanduser(value)))


def configure():
    global STATE_FILE, PI_SESSION_DIR, CLAUDE_SESSION_DIR, COMMAND_PATHS
    config = read_config()
    state = os.environ.get("DONJON_STATE") or "~/.donjon/state.json"
    pi_sessions = os.environ.get("PI_CODING_AGENT_SESSION_DIR")
    if not pi_sessions:
        pi_sessions = config.get("pi.sessionDir")
    if not pi_sessions:
        pi_sessions = str(expand_path(os.environ.get("PI_CODING_AGENT_DIR", "~/.pi/agent")) / "sessions")
    claude_sessions = config.get("claude.sessionDir")
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        claude_sessions = str(expand_path(os.environ["CLAUDE_CONFIG_DIR"]) / "projects")
    STATE_FILE = expand_path(state)
    PI_SESSION_DIR = expand_path(pi_sessions)
    CLAUDE_SESSION_DIR = expand_path(claude_sessions or "~/.claude/projects")
    COMMAND_PATHS = {
        "pi": os.environ.get("DONJON_PI_PATH") or config.get("pi.path") or "pi",
        "claude": os.environ.get("DONJON_CLAUDE_PATH") or config.get("claude.path") or "claude",
        "fzf": os.environ.get("DONJON_FZF_PATH") or config.get("tools.fzf.path") or "fzf",
    }
    COMMAND_PATHS = {
        name: os.path.expandvars(os.path.expanduser(path))
        for name, path in COMMAND_PATHS.items()
    }


def fail(message):
    raise DonjonError(message)


def init_state():
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    if not STATE_FILE.exists():
        STATE_FILE.write_text("[]\n")
        STATE_FILE.chmod(0o600)


def read_state():
    try:
        rows = json.loads(STATE_FILE.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {STATE_FILE}: {error}")
    if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):
        fail(f"{STATE_FILE} must contain a JSON array of objects")
    return rows


def write_state(rows):
    fd, temporary = tempfile.mkstemp(prefix=".state.", dir=STATE_FILE.parent, text=True)
    try:
        with os.fdopen(fd, "w") as file:
            json.dump(rows, file, indent=2)
            file.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, STATE_FILE)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def register_agent(name, directory, harness, session_id, custom_id=None):
    rows = read_state()
    if any(row.get("id") == session_id for row in rows):
        fail(f"session {session_id!r} is already registered")
    if custom_id and any(row.get("customId") == custom_id for row in rows):
        fail(f"custom id {custom_id!r} already exists")
    row = {"name": name, "dir": directory, "harness": harness, "id": session_id}
    if custom_id:
        row["customId"] = custom_id
    rows.append(row)
    write_state(rows)


def lookup(query):
    rows = read_state()
    exact = [row for row in rows if row.get("id") == query or row.get("customId") == query]
    matches = exact or [row for row in rows if row.get("id", "").startswith(query)]
    if not matches:
        fail(f"no agent matches {query!r}")
    if len(matches) > 1:
        fail(f"{query!r} is ambiguous")
    return matches[0]


def require_command(name):
    command = COMMAND_PATHS[name]
    if not shutil.which(command):
        fail(f"{name} command not found: {command}")
    return command


def attach_record(row):
    directory = row.get("dir", "")
    session_id = row.get("id", "")
    harness = row.get("harness", "pi")
    if not os.path.isdir(directory):
        fail(f"directory no longer exists: {directory}")
    command = require_command(harness)
    os.chdir(directory)
    if harness == "pi":
        os.execvp(command, [command, "--session", session_id])
    if harness == "claude":
        os.execvp(command, [command, "--resume", session_id])
    fail(f"unsupported harness in registry: {harness}")


def new_agent(args):
    command = require_command(args.harness)
    if not os.path.isdir(args.dir):
        fail(f"directory does not exist: {args.dir}")
    directory = os.path.realpath(args.dir)
    init_state()
    session_id = str(uuid.uuid4())
    register_agent(args.name, directory, args.harness, session_id, args.custom_id)
    os.chdir(directory)
    os.execvp(
        command,
        [command, "--session-id", session_id, "--name", args.name],
    )


def find_session_directory(root, session_id, harness):
    label = "Pi" if harness == "pi" else "Claude Code"
    if not root.is_dir():
        fail(f"{label} session directory does not exist: {root}")

    matches = []
    for directory, _, filenames in os.walk(root):
        for filename in filenames:
            if not filename.endswith(".jsonl"):
                continue
            path = Path(directory) / filename
            try:
                with path.open() as file:
                    if harness == "pi":
                        header = json.loads(file.readline())
                        if header.get("type") == "session" and header.get("id") == session_id:
                            matches.append((path, header.get("cwd")))
                    elif filename == f"{session_id}.jsonl":
                        cwd = None
                        found_id = False
                        for line in file:
                            entry = json.loads(line)
                            found_id = found_id or entry.get("sessionId") == session_id
                            cwd = cwd or entry.get("cwd")
                            if found_id and cwd:
                                break
                        if found_id:
                            matches.append((path, cwd))
            except (OSError, UnicodeError, json.JSONDecodeError, AttributeError):
                continue

    if not matches:
        fail(f"no {label} session matches {session_id!r}")
    if len(matches) > 1:
        fail(f"{label} session {session_id!r} is ambiguous")
    cwd = matches[0][1]
    if not isinstance(cwd, str) or not cwd:
        fail(f"{label} session {session_id!r} has no working directory")
    return cwd


def onboard_agent(args):
    init_state()
    root = PI_SESSION_DIR if args.harness == "pi" else CLAUDE_SESSION_DIR
    directory = find_session_directory(root, args.id, args.harness)
    if not os.path.isdir(directory):
        fail(f"session directory no longer exists: {directory}")
    directory = os.path.realpath(directory)
    register_agent(args.name, directory, args.harness, args.id)
    print(f"Onboarded {args.name} {args.harness} session ({args.id})")


def paint(text, code, enabled):
    return f"\033[{code}m{text}\033[0m" if enabled else text


def display_rows(rows, color=False):
    identifiers = [
        str(row.get("customId") or row.get("id", "")).split("-", 1)[0]
        for row in rows
    ]
    id_width = max(2, *(len(ident) for ident in identifiers))
    name_width = max(4, *(len(str(row.get("name", ""))) for row in rows))
    project_width = max(7, *(len(str(row.get("dir", ""))) for row in rows))
    yield "  ".join(
        (
            paint(f'{"ID":<{id_width}}', "1;33", color),
            paint(f'{"TASK":<{name_width}}', "1;36", color),
            paint(f'{"PROJECT":<{project_width}}', "1;34", color),
            paint("HARNESS", "1;35", color),
        )
    )
    for row, ident in zip(rows, identifiers):
        name = str(row.get("name", ""))
        directory = str(row.get("dir", ""))
        harness = str(row.get("harness", "pi"))
        harness_color = "32" if harness == "pi" else "35"
        yield "  ".join(
            (
                paint(f"{ident:<{id_width}}", "33", color),
                paint(f"{name:<{name_width}}", "36", color),
                paint(f"{directory:<{project_width}}", "34", color),
                paint(f"{harness:<7}", harness_color, color),
            )
        )


def list_agents(_args):
    init_state()
    rows = read_state()
    if not rows:
        print("No registered agents.")
        return
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb"
    print("\n".join(display_rows(rows, color=color)))


def clean_display(value):
    return str(value).replace("\t", " ").replace("\r", " ").replace("\n", " ")


def select_session(_args):
    fzf = require_command("fzf")
    init_state()
    rows = read_state()
    if not rows:
        print("No registered agents.")
        return

    clean_rows = [
        {
            **row,
            "name": clean_display(row.get("name", "")),
            "dir": clean_display(row.get("dir", "")),
            "harness": clean_display(row.get("harness", "pi")),
            "customId": clean_display(row.get("customId", "")),
            "id": clean_display(row.get("id", "")),
        }
        for row in rows
    ]
    displayed = list(display_rows(clean_rows))
    choices = [f"\t{displayed[0]}"] + [
        f"{index}\t{line}" for index, line in enumerate(displayed[1:])
    ]
    result = subprocess.run(
        [
            fzf,
            "--delimiter=\t",
            "--with-nth=2",
            "--header-lines=1",
            "--layout=reverse",
            "--border",
            "--prompt=Session> ",
            "--bind=left-click:accept",
        ],
        input="\n".join(choices) + "\n",
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if result.returncode in (1, 130):
        return
    if result.returncode:
        fail(f"fzf exited with status {result.returncode}")
    try:
        index = int(result.stdout.partition("\t")[0])
        row = rows[index]
    except (ValueError, IndexError):
        fail("fzf returned an invalid selection")
    attach_record(row)


def attach_agent(args):
    init_state()
    attach_record(lookup(args.id))


def remove_agent(args):
    init_state()
    row = lookup(args.id)
    session_id = row.get("id", "")
    rows = [candidate for candidate in read_state() if candidate.get("id") != session_id]
    write_state(rows)
    print(f"Removed agent {session_id}")


def build_parser():
    parser = argparse.ArgumentParser(
        prog="donjon",
        description="Name, track, and attach to Pi and Claude Code sessions.",
    )
    commands = parser.add_subparsers(dest="command", required=True)

    new = commands.add_parser("new", help="start and register a new session")
    new.add_argument("--name", required=True)
    new.add_argument("--dir", required=True)
    new.add_argument("--harness", choices=("pi", "claude"), default="pi")
    new.add_argument("--custom-id")
    new.set_defaults(handler=new_agent)

    onboard = commands.add_parser("onboard", help="register an existing session")
    onboard.add_argument("--name", required=True)
    onboard.add_argument("--id", required=True)
    onboard.add_argument("--harness", choices=("pi", "claude"), default="pi")
    onboard.set_defaults(handler=onboard_agent)

    listing = commands.add_parser("ls", help="list registered sessions")
    listing.set_defaults(handler=list_agents)

    sessions = commands.add_parser("sessions", help="interactively choose a session")
    sessions.set_defaults(handler=select_session)

    attach = commands.add_parser("attach", help="attach to a registered session")
    attach.add_argument("--id", required=True, help="custom ID or session ID prefix")
    attach.set_defaults(handler=attach_agent)

    remove = commands.add_parser("rm", help="remove a session from the registry")
    remove.add_argument("id", help="custom ID or session ID prefix")
    remove.set_defaults(handler=remove_agent)
    return parser


def main():
    try:
        configure()
        args = build_parser().parse_args()
        args.handler(args)
    except DonjonError as error:
        print(f"donjon: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
