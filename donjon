#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${DONJON_STATE:-${HOME}/.donjon/state.json}"
PI_SESSION_DIR="${PI_CODING_AGENT_SESSION_DIR:-${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}/sessions}"
CLAUDE_SESSION_DIR="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/projects"

usage() {
  cat <<'EOF'
Usage:
  donjon new --name NAME --dir DIR [--harness pi|claude] [--custom-id ID]
  donjon onboard --name NAME --id SESSION_ID [--harness pi|claude]
  donjon ls
  donjon sessions
  donjon attach --id ID_OR_PREFIX
  donjon rm ID_OR_PREFIX
EOF
}

die() {
  printf 'donjon: %s\n' "$*" >&2
  exit 1
}

need_arg() {
  [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value"
}

init_state() {
  mkdir -p -- "$(dirname -- "$STATE_FILE")"
  if [[ ! -e "$STATE_FILE" ]]; then
    printf '[]\n' >"$STATE_FILE"
    chmod 600 "$STATE_FILE"
  fi
}

# Prints: directory<TAB>session-id<TAB>harness. Exact IDs/custom IDs win; otherwise a
# unique session-ID prefix is accepted.
lookup() {
  python3 - "$STATE_FILE" "$1" <<'PY'
import json, sys
path, query = sys.argv[1:]
try:
    with open(path) as f:
        rows = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    raise SystemExit(f"donjon: cannot read {path}: {e}")

exact = [r for r in rows if r.get("id") == query or r.get("customId") == query]
matches = exact if exact else [r for r in rows if r.get("id", "").startswith(query)]
if not matches:
    raise SystemExit(f"donjon: no agent matches {query!r}")
if len(matches) > 1:
    raise SystemExit(f"donjon: {query!r} is ambiguous")
r = matches[0]
print(f'{r["dir"]}\t{r["id"]}\t{r.get("harness", "pi")}')
PY
}

register_agent() {
  local name=$1 dir=$2 harness=$3 id=$4 custom_id=${5:-}
  python3 - "$STATE_FILE" "$name" "$dir" "$harness" "$id" "$custom_id" <<'PY'
import json, os, sys, tempfile
path, name, directory, harness, session_id, custom_id = sys.argv[1:]
try:
    with open(path) as f:
        rows = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    raise SystemExit(f"donjon: cannot read {path}: {e}")
if not isinstance(rows, list):
    raise SystemExit(f"donjon: {path} must contain a JSON array")
if any(r.get("id") == session_id for r in rows):
    raise SystemExit(f"donjon: session {session_id!r} is already registered")
if custom_id and any(r.get("customId") == custom_id for r in rows):
    raise SystemExit(f"donjon: custom id {custom_id!r} already exists")
row = {"name": name, "dir": directory, "harness": harness, "id": session_id}
if custom_id:
    row["customId"] = custom_id
rows.append(row)
fd, tmp = tempfile.mkstemp(prefix=".state.", dir=os.path.dirname(path), text=True)
try:
    with os.fdopen(fd, "w") as f:
        json.dump(rows, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
except BaseException:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PY
}

new_agent() {
  local name='' dir='' harness='pi' custom_id=''
  while (($#)); do
    case "$1" in
      --name)
        need_arg "$@"; name=$2; shift 2 ;;
      --dir)
        need_arg "$@"; dir=$2; shift 2 ;;
      --harness)
        need_arg "$@"; harness=$2; shift 2 ;;
      --custom-id)
        need_arg "$@"; custom_id=$2; shift 2 ;;
      -h|--help)
        usage; exit 0 ;;
      *) die "unknown option for new: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die 'new requires --name'
  [[ -n "$dir" ]] || die 'new requires --dir'
  [[ "$harness" == pi || "$harness" == claude ]] || die "unsupported harness: $harness"
  command -v "$harness" >/dev/null 2>&1 || die "$harness is not installed or not in PATH"
  dir=$(cd -- "$dir" 2>/dev/null && pwd -P) || die "directory does not exist: $dir"

  init_state
  local id
  id=$(python3 -c 'import uuid; print(uuid.uuid4())')

  register_agent "$name" "$dir" "$harness" "$id" "$custom_id"

  cd -- "$dir"
  case "$harness" in
    pi) exec pi --session-id "$id" --name "$name" ;;
    claude) exec claude --session-id "$id" --name "$name" ;;
  esac
}

onboard_agent() {
  local name='' id='' harness='pi'
  while (($#)); do
    case "$1" in
      --name)
        need_arg "$@"; name=$2; shift 2 ;;
      --id)
        need_arg "$@"; id=$2; shift 2 ;;
      --harness)
        need_arg "$@"; harness=$2; shift 2 ;;
      -h|--help)
        usage; exit 0 ;;
      *) die "unknown option for onboard: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die 'onboard requires --name'
  [[ -n "$id" ]] || die 'onboard requires --id'
  [[ "$harness" == pi || "$harness" == claude ]] || die "unsupported harness: $harness"
  init_state

  local session_root=$PI_SESSION_DIR
  [[ "$harness" == claude ]] && session_root=$CLAUDE_SESSION_DIR
  local dir
  dir=$(python3 - "$session_root" "$id" "$harness" <<'PY'
import json, os, sys
root, session_id, harness = sys.argv[1:]
label = "Pi" if harness == "pi" else "Claude Code"
if not os.path.isdir(root):
    raise SystemExit(f"donjon: {label} session directory does not exist: {root}")

matches = []
for directory, _, files in os.walk(root):
    for filename in files:
        if not filename.endswith(".jsonl"):
            continue
        path = os.path.join(directory, filename)
        try:
            with open(path) as f:
                if harness == "pi":
                    header = json.loads(f.readline())
                    if header.get("type") == "session" and header.get("id") == session_id:
                        matches.append((path, header.get("cwd")))
                elif filename == f"{session_id}.jsonl":
                    cwd = None
                    found_id = False
                    for line in f:
                        entry = json.loads(line)
                        found_id = found_id or entry.get("sessionId") == session_id
                        cwd = cwd or entry.get("cwd")
                        if found_id and cwd:
                            break
                    if found_id:
                        matches.append((path, cwd))
        except (OSError, json.JSONDecodeError):
            continue

if not matches:
    raise SystemExit(f"donjon: no {label} session matches {session_id!r}")
if len(matches) > 1:
    raise SystemExit(f"donjon: {label} session {session_id!r} is ambiguous")
_, cwd = matches[0]
if not isinstance(cwd, str) or not cwd:
    raise SystemExit(f"donjon: {label} session {session_id!r} has no working directory")
print(cwd)
PY
)
  [[ -d "$dir" ]] || die "session directory no longer exists: $dir"
  dir=$(cd -- "$dir" && pwd -P)
  register_agent "$name" "$dir" "$harness" "$id"
  printf 'Onboarded %s %s session (%s)\n' "$name" "$harness" "$id"
}

list_agents() {
  init_state
  python3 - "$STATE_FILE" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path) as f:
        rows = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    raise SystemExit(f"donjon: cannot read {path}: {e}")
if not rows:
    print("No registered agents.")
    raise SystemExit
task_width = max(4, *(len(r.get("name", "")) for r in rows))
project_width = max(7, *(len(r.get("dir", "")) for r in rows))
print(f'{"TASK":<{task_width}}  {"PROJECT":<{project_width}}  HARNESS  ID')
for r in rows:
    ident = r.get("customId") or r.get("id", "")
    print(f'{r.get("name", ""):<{task_width}}  {r.get("dir", ""):<{project_width}}  {r.get("harness", "pi"):<7}  {ident}')
PY
}

select_session() {
  command -v fzf >/dev/null 2>&1 || die 'fzf is not installed or not in PATH'
  init_state
  local choices selected id
  choices=$(python3 - "$STATE_FILE" <<'PY'
import json, sys
path = sys.argv[1]
try:
    with open(path) as f:
        rows = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    raise SystemExit(f"donjon: cannot read {path}: {e}")
if not rows:
    raise SystemExit
name_width = max(4, *(len(r.get("name", "")) for r in rows))
project_width = max(7, *(len(r.get("dir", "")) for r in rows))
print(f'\t{"TASK":<{name_width}}  {"PROJECT":<{project_width}}  HARNESS  ID')
for r in rows:
    session_id = r.get("id", "")
    ident = r.get("customId") or session_id
    display = f'{r.get("name", ""):<{name_width}}  {r.get("dir", ""):<{project_width}}  {r.get("harness", "pi"):<7}  {ident}'
    print(f'{session_id}\t{display}')
PY
)
  [[ -n "$choices" ]] || { printf 'No registered agents.\n'; return; }
  selected=$(printf '%s\n' "$choices" | fzf \
    --delimiter=$'\t' --with-nth=2 --header-lines=1 --layout=reverse --border \
    --prompt='Session> ' --bind='left-click:accept') || return 0
  id=${selected%%$'\t'*}
  attach_agent --id "$id"
}

attach_agent() {
  local query=''
  while (($#)); do
    case "$1" in
      --id)
        need_arg "$@"; query=$2; shift 2 ;;
      -h|--help)
        usage; exit 0 ;;
      *) die "unknown option for attach: $1" ;;
    esac
  done
  [[ -n "$query" ]] || die 'attach requires --id'
  init_state
  local record dir id harness
  record=$(lookup "$query")
  IFS=$'\t' read -r dir id harness <<<"$record"
  [[ -d "$dir" ]] || die "directory no longer exists: $dir"
  command -v "$harness" >/dev/null 2>&1 || die "$harness is not installed or not in PATH"
  cd -- "$dir"
  case "$harness" in
    pi) exec pi --session "$id" ;;
    claude) exec claude --resume "$id" ;;
    *) die "unsupported harness in registry: $harness" ;;
  esac
}

remove_agent() {
  [[ $# -eq 1 ]] || die 'rm requires exactly one ID or prefix'
  init_state
  local record dir id harness
  record=$(lookup "$1")
  IFS=$'\t' read -r dir id harness <<<"$record"
  python3 - "$STATE_FILE" "$id" <<'PY'
import json, os, sys, tempfile
path, session_id = sys.argv[1:]
with open(path) as f:
    rows = json.load(f)
rows = [r for r in rows if r.get("id") != session_id]
fd, tmp = tempfile.mkstemp(prefix=".state.", dir=os.path.dirname(path), text=True)
try:
    with os.fdopen(fd, "w") as f:
        json.dump(rows, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
except BaseException:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PY
  printf 'Removed agent %s\n' "$id"
}

(($#)) || { usage; exit 1; }
command=$1
shift
case "$command" in
  new) new_agent "$@" ;;
  onboard) onboard_agent "$@" ;;
  ls) (($# == 0)) || die 'ls takes no arguments'; list_agents ;;
  sessions) (($# == 0)) || die 'sessions takes no arguments'; select_session ;;
  attach) attach_agent "$@" ;;
  rm) remove_agent "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $command" ;;
esac
